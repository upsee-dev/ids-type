{
  "expo": {
    "name": "カタチ入力",
    "slug": "ids-kanji-type",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ids-kanji-type",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#FBFBF9",
    "primaryColor": "#4437D1",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.upsee.idskanjitype",
      "appleTeamId": "W8P3V5NG4R"
    },
    "android": {
      "package": "com.upsee.idskanjitype",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FBFBF9",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FBFBF9",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0C0A09"
          }
        }
      ],
      "expo-font",
      "./plugins/withKatachiIme"
    ],
    "updates": {
      "url": "https://u.expo.dev/",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.upsee.idskanjitype.keyboard",
                  "targetName": "keyboard"
                }
              ]
            }
          }
        },
        "projectId": "f16a9cca-5309-499e-8324-c46580f7942e"
      }
    },
    "owner": "upsee"
  }
}

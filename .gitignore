# macOS
.DS_Store

# 依存関係・ビルド成果物
node_modules/
.next/
dist/
build/

# Expo が prebuild で生成するネイティブプロジェクト
native/android/
native/ios/
native/.expo/
native/src/core/

# 元データ（kanjidic2.xml は 15MB。data-src/fetch.mjs で取り直せる）
data-src/kanjidic2/kanjidic2.xml

# ログ・一時ファイル
*.log
*.tsbuildinfo

# サブセットの元フォント（32MB）。scripts/build-font-*.py の実行時だけ要る。
# 配布物は web/public/fonts/ と native/assets/fonts/ の切り出しのほう。
# そちらは34MBあるが、EAS Build も Vercel も Python を回さない（元フォントも
# 持たない）ので、リポジトリに入れておかないとビルドが ☒ だらけになる。
assets-archive/fonts/Plangothic*.ttf

# 静的書き出し（EAS Hosting へのデプロイ時に作る一時物）
web/out/
web/dist/
native/dist/

# ストア自動化の認証情報。絶対にコミットしないこと
# （ASC の秘密鍵と Google Play のサービスアカウント）
store/AuthKey/
*.p8
*-service-account*.json

